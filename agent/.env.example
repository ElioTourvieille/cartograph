# The agent is its own process and holds its own keys: none of the
# application's secrets (Clerk, Convex, the pipeline secret) belong here.
ANTHROPIC_API_KEY=
# Where the application's read-only tool surface is reachable from this process.
CARTOGRAPH_TOOLS_URL=http://localhost:3000/api/agent/tools
# Optional: record the agent's runs in LangSmith, as the application does.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
